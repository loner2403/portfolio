{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.harshallade.site"
        }
      ],
      "destination": "https://harshallade.site/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "portfolio-2-omega-lovat.vercel.app"
        }
      ],
      "destination": "https://harshallade.site/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "portfolio-2-loner2403s-projects.vercel.app"
        }
      ],
      "destination": "https://harshallade.site/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "portfolio-2-git-main-loner2403s-projects.vercel.app"
        }
      ],
      "destination": "https://harshallade.site/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "portfolio-2-loner2403-loner2403s-projects.vercel.app"
        }
      ],
      "destination": "https://harshallade.site/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "harshallade.xyz"
        }
      ],
      "destination": "https://harshallade.site/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.harshallade.xyz"
        }
      ],
      "destination": "https://harshallade.site/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/projects/:slug(vyapardrishti|meeting-assistant|thumbnail-ai|medium-blog-clone|resume-roaster)",
      "destination": "/index.html"
    },
    {
      "source": "/systems/:slug(research-agent-workflows|document-extraction-pipeline|data-ingestion-services|conversational-assistant|batch-analysis-jobs)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "trailingSlash": false
}
